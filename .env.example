# Autenticación (servidor de cuentas GoTrue, corre en el VPS): URL y clave pública. En local, `supabase status` (desde Festy-back).
# En producción: la URL del VPS (https://api.tudominio.com) y ANON_KEY de despliegue/.env.
VITE_AUTH_URL=http://127.0.0.1:64321
VITE_AUTH_KEY=
# API de Festy (Festy-back). Todos los datos pasan por acá. En producción: https://api.tudominio.com/api
VITE_API_URL=http://127.0.0.1:4000/api
# Solo en desarrollo local (las pruebas e2e se registran): muestra «Crear cuenta». En producción, sin definir.
VITE_REGISTRO_PUBLICO=true
