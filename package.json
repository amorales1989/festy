{
  "name": "festy",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Festy — plataforma SaaS para salones de eventos",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc -b",
    "test": "vitest run",
    "test:db": "cd ../Festy-back && supabase test db",
    "test:concurrencia": "bash ../Festy-back/scripts/prueba_concurrencia.sh",
    "db:reset": "cd ../Festy-back && supabase db reset",
    "db:tipos": "cd ../Festy-back && supabase gen types typescript --local --schema public > ../festy/src/tipos/database.ts",
    "demo": "bash ../Festy-back/scripts/demo.sh",
    "build:android": "vite build --mode android && cap sync android",
    "apk": "pnpm build:android && cd android && ./gradlew assembleDebug",
    "apk:dev": "CAP_DESARROLLO=1 pnpm apk",
    "demo:build": "vite build --mode tunel --outDir dist-demo",
    "demo:servir": "vite preview --mode tunel --outDir dist-demo",
    "demo:tunel": "cloudflared tunnel --no-autoupdate --url http://localhost:4173",
    "api": "cd ../Festy-back && npm run dev"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.4",
    "@capacitor/push-notifications": "^8.1.3",
    "@capacitor/share": "^8.0.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@date-fns/tz": "^1.5.0",
    "@supabase/supabase-js": "^2.117.3",
    "date-fns": "^4.4.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-vue-next": "^1.0.0",
    "papaparse": "^5.7.0",
    "pinia": "^4.0.3",
    "vue": "^3.5.43",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/papaparse": "^5.5.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "jsdom": "^30.1.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.4",
    "vue-tsc": "^3.3.13"
  }
}
