# Variables para compilar la app Android (pnpm build:android).
# En producción: la URL https del VPS y la clave pública (ANON_KEY de Festy-back/despliegue/.env).
VITE_AUTH_URL=https://api.tudominio.com
VITE_AUTH_KEY=
VITE_API_URL=https://api.tudominio.com/api
# Poner en true SOLO cuando android/app/google-services.json exista (Firebase).
VITE_PUSH_HABILITADO=false
